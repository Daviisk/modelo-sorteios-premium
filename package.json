    "jose": "5.6.3",
    "next": "15.5.27",
    "qrcode": "1.5.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.14.15",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.28",
    "prisma": "5.18.0",
    "tailwindcss": "3.4.9",
    "tsx": "4.16.5",
