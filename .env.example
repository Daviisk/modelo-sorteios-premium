# Banco de dados: conexão da aplicação e conexão direta para migrations
DATABASE_URL=""
DIRECT_URL=""

# Autenticação administrativa: gere com crypto.randomBytes(32).toString('hex')
AUTH_SECRET=""
AUTH_SESSION_MAX_AGE=604800

# Use mercadopago para PIX pela API; mock serve apenas para demonstração.
PAYMENT_PROVIDER="mock"
RESERVATION_MINUTES=32

# Mercado Pago — credenciais privadas, usadas somente no servidor
# Preencha no .env local ou nas variáveis do ambiente de hospedagem.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# URL pública HTTPS que receberá as notificações de pagamento
MERCADOPAGO_NOTIFICATION_URL="https://modelo-sorteios-premium-two.vercel.app/api/webhooks/payment"

# Opcional: Public Key para uma futura integração com MercadoPago.js/Bricks.
# A criação de PIX diretamente pela API no servidor não usa esta variável.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""

# Segredo do endpoint de liberação de reservas expiradas
CRON_SECRET=""

# Identificação jurídica do controlador e canal específico de privacidade.
PRIVACY_CONTROLLER_NAME=""
PRIVACY_CONTACT_EMAIL=""

